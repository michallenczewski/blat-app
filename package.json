{
  "name": "blat-app",
  "productName": "Blat",
  "version": "0.2.1",
  "description": "Blat — lekka tablica referencji w języku wizualnym Gapy",
  "author": "Michał Lenczewski",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.mjs",
    "tlumaczenia": "node scripts/tlumaczenia.mjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "pl.lenczewski.blat",
    "productName": "Blat",
    "artifactName": "Blat-${version}-${os}-${arch}.${ext}",
    "files": ["main.js", "preload.js", "renderer/**"],
    "directories": { "output": "dist" },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }, { "target": "zip", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": { "title": "Blat ${version}" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon-win.png",
      "executableName": "Blat"
    },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Blat" },
    "afterSign": "build/adhoc.js"
  }
}
